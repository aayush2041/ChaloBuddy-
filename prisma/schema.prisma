generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                      String               @id @default(cuid())
  email                                   String               @unique
  passwordHash                            String
  name                                    String
  createdAt                               DateTime             @default(now())
  updatedAt                               DateTime             @updatedAt
  BlockedUser_BlockedUser_blockedIdToUser BlockedUser[]        @relation("BlockedUser_blockedIdToUser")
  BlockedUser_BlockedUser_blockerIdToUser BlockedUser[]        @relation("BlockedUser_blockerIdToUser")
  Expense                                 Expense[]
  ExpenseParticipant                      ExpenseParticipant[]
  sentMessages                            Message[]            @relation("SentMessages")
  notifications                           Notification[]
  PollVote                                PollVote[]
  Profile                                 Profile?
  Report                                  Report[]
  Review_Review_revieweeIdToUser          Review[]             @relation("Review_revieweeIdToUser")
  Review_Review_reviewerIdToUser          Review[]             @relation("Review_reviewerIdToUser")
  savedTrips                              SavedTrip[]
  Session                                 Session[]
  Task                                    Task[]
  TravelPassport                          TravelPassport?
  TravelPreference                        TravelPreference?
  Trip                                    Trip[]
  TripMember                              TripMember[]
  TripRequest                             TripRequest[]
  UserInterest                            UserInterest[]
  Verification                            Verification?
}

model Trip {
  id                 String               @id @default(cuid())
  creatorId          String
  title              String
  startingCity       String
  startingLat        Float?
  startingLng        Float?
  destination        String
  destinationLat     Float?
  destinationLng     Float?
  startDate          DateTime
  endDate            DateTime
  budgetMin          Int
  budgetMax          Int
  groupSize          Int
  description        String
  included           String?
  excluded           String?
  transport          Transport
  accommodation      Accommodation
  travelStyle        TravelStyle
  intensity          Intensity
  status             TripStatus           @default(PUBLISHED)
  scope              String               @default("NATIONAL")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  CompatibilityMatch CompatibilityMatch[]
  Conversation       Conversation[]
  Expense            Expense[]
  Itinerary          Itinerary?
  Poll               Poll[]
  Report             Report[]
  reviews            Review[]
  savedBy            SavedTrip[]
  Task               Task[]
  User               User                 @relation(fields: [creatorId], references: [id])
  TripMember         TripMember[]
  TripRequest        TripRequest[]
  TripRoom           TripRoom?

  @@index([destination])
  @@index([startDate])
  @@index([status])
  @@index([budgetMin, budgetMax])
  @@index([endDate])
  @@index([scope])
  @@index([startingCity])
}

model Conversation {
  id        String    @id @default(cuid())
  tripId    String?
  title     String?
  createdAt DateTime  @default(now())
  Trip      Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([tripId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Review {
  id                           String   @id @default(cuid())
  tripId                       String
  reviewerId                   String
  revieweeId                   String
  rating                       Int
  comment                      String?
  createdAt                    DateTime @default(now())
  User_Review_revieweeIdToUser User     @relation("Review_revieweeIdToUser", fields: [revieweeId], references: [id])
  User_Review_reviewerIdToUser User     @relation("Review_reviewerIdToUser", fields: [reviewerId], references: [id])
  trip                         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, reviewerId, revieweeId])
}

model SavedTrip {
  userId    String
  tripId    String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tripId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AdminUser {
  id               String             @id
  email            String             @unique
  createdAt        DateTime           @default(now())
  AuditLog         AuditLog[]
  ModerationAction ModerationAction[]
}

model AuditLog {
  id        String    @id
  adminId   String
  action    String
  targetId  String?
  metadata  String?
  createdAt DateTime  @default(now())
  AdminUser AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model BlockedUser {
  blockerId                        String
  blockedId                        String
  createdAt                        DateTime @default(now())
  User_BlockedUser_blockedIdToUser User     @relation("BlockedUser_blockedIdToUser", fields: [blockedId], references: [id], onDelete: Cascade)
  User_BlockedUser_blockerIdToUser User     @relation("BlockedUser_blockerIdToUser", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model CompatibilityMatch {
  id        String   @id
  tripId    String
  userId    String
  score     Float
  createdAt DateTime @default(now())
  Trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Expense {
  id                 String               @id
  tripId             String
  payerId            String
  amount             Int
  description        String
  createdAt          DateTime             @default(now())
  User               User                 @relation(fields: [payerId], references: [id])
  Trip               Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ExpenseParticipant ExpenseParticipant[]
}

model ExpenseParticipant {
  id        String  @id
  expenseId String
  userId    String
  share     Int
  Expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model Interest {
  id           String         @id
  name         String         @unique
  UserInterest UserInterest[]
}

model Itinerary {
  id             String         @id
  tripId         String         @unique
  generatedAt    DateTime       @default(now())
  routeSummary   String?
  howToReach     String?
  stayAreas      String?
  estimatedTotal Int?
  Trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ItineraryDay   ItineraryDay[]
}

model ItineraryDay {
  id            String          @id
  itineraryId   String
  dayNumber     Int
  title         String
  Itinerary     Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  ItineraryItem ItineraryItem[]

  @@unique([itineraryId, dayNumber])
}

model ItineraryItem {
  id            String       @id
  dayId         String
  time          String?
  activity      String
  location      String?
  notes         String?
  estimatedCost Int          @default(0)
  ItineraryDay  ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model ModerationAction {
  id        String    @id
  adminId   String
  action    String
  targetId  String
  createdAt DateTime  @default(now())
  AdminUser AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Poll {
  id         String       @id
  tripId     String
  question   String
  createdAt  DateTime     @default(now())
  Trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  PollOption PollOption[]
}

model PollOption {
  id       String     @id
  pollId   String
  label    String
  Poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  PollVote PollVote[]
}

model PollVote {
  id         String     @id
  optionId   String
  userId     String
  PollOption PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  User       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
}

model Profile {
  id               String       @id
  userId           String       @unique
  avatarUrl        String?
  bio              String?
  city             String?
  travelStyle      TravelStyle?
  tripsCompleted   Int          @default(0)
  citiesVisited    Int          @default(0)
  countriesVisited Int          @default(0)
  companionRating  Float        @default(5)
  User             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id             String     @id
  reporterId     String
  type           ReportType
  reason         String
  tripId         String?
  reportedUserId String?
  createdAt      DateTime   @default(now())
  User           User       @relation(fields: [reporterId], references: [id])
  Trip           Trip?      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Task {
  id         String    @id
  tripId     String
  assigneeId String?
  title      String
  status     String    @default("OPEN")
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  User       User?     @relation(fields: [assigneeId], references: [id])
  Trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TravelPassport {
  id         String  @id
  userId     String  @unique
  highlights String?
  User       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelPreference {
  id                     String         @id
  userId                 String         @unique
  preferredTransport     Transport?
  preferredAccommodation Accommodation?
  budgetMin              Int?
  budgetMax              Int?
  User                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TripMember {
  id       String   @id
  tripId   String
  userId   String
  joinedAt DateTime @default(now())
  Trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  User     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model TripRequest {
  id          String        @id
  tripId      String
  requesterId String
  message     String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  User        User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  Trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, requesterId])
  @@index([status])
}

model TripRoom {
  id        String   @id
  tripId    String   @unique
  createdAt DateTime @default(now())
  Trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model UserInterest {
  userId     String
  interestId String
  Interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Verification {
  id         String    @id
  userId     String    @unique
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum TripStatus {
  DRAFT
  PUBLISHED
  GROUP_FORMING
  FULL
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Accommodation {
  HOSTEL
  HOTEL
  HOMESTAY
  CAMPING
  MIXED
}

enum Intensity {
  EASY
  MODERATE
  HIGH
}

enum NotificationType {
  JOIN_REQUEST
  JOIN_ACCEPTED
  JOIN_DECLINED
  TRIP_UPDATED
  TRIP_CANCELLED
  MESSAGE
  POLL_CREATED
  TASK_ASSIGNED
}

enum ReportType {
  USER
  TRIP
}

enum Transport {
  CAR
  BUS
  TRAIN
  FLIGHT
  MIXED
}

enum TravelStyle {
  ADVENTURE
  RELAXED
  BACKPACKING
  LUXURY
  NATURE
  CULTURAL
}
