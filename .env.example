# ==========================================
# ChaloBuddy Environment Variables
# ==========================================

# PostgreSQL / Neon Database Connection String
# Example Neon URL: postgresql://[user]:[password]@[endpoint].neon.tech/chalobuddy?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chalobuddy?sslmode=disable"

# Authentication Secret (Minimum 32 random characters for JWT signing)
JWT_SECRET="chalobuddy_super_secure_production_secret_key_2026_xyz"

# Server Port
PORT=5000

# Client Frontend URL (for CORS)
CLIENT_URL="http://localhost:5173"
